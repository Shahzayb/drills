# The owner/superuser. Migrations and the seed use this, and nothing else does.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=drills
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
# The role the API serves with, created by migration 003. It has no default and
# the API refuses to start without it — row-level security exempts the table
# owner and every superuser, so serving as POSTGRES_USER above would leave the
# policies in the schema enforcing nothing, with every test still passing.
# See plans/2026-08-15_drill-07-tenant-isolation.md.
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=app_user_pass
REDIS_PASSWORD=default_secure_pass
REDIS_HOST=redis_cache
REDIS_PORT=6379
BACKEND_PORT=3002
FRONTEND_PORT=3001
# How the Next server reaches the API: Compose service name, not localhost.
BACKEND_INTERNAL_URL=http://nest_server:3002
# pino level, both apps. info = one line per request; debug = the inside of one
# (what `pnpm logs:trace` needs); silent = off. Shell env overrides this.
LOG_LEVEL=info
# OpenTelemetry is off unless this is set, and `pnpm trace:on` sets it for you
# (to http://otel_collector:4318) while starting the collector in the same
# command. Setting it here instead would point both apps at a collector that is
# not running, which is a retry loop rather than a trace. Jaeger's UI is then on
# http://localhost:16686.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Card 08 (N+1 detection). Empty = ConversationsService's own default
# (batched: 3 statements). `LIST_STRATEGY=naive docker compose up -d
# nest_server` is the one-line A/B switch, same pattern as LOG_LEVEL above.
# See plans/2026-08-17_drill-08-n-plus-one.md.
LIST_STRATEGY=
# Card 10, and the same one-line A/B switch as LIST_STRATEGY above:
# `KEYSET_TIEBREAK=off docker compose up -d nest_server` drops `id` from the
# cursor's row comparison. See plans/2026-08-26_drill-10-keyset-pagination.md.
KEYSET_TIEBREAK=
# Card 11 (search). Empty = SearchService's own default (fts). `SEARCH_STRATEGY=
# like docker compose up -d nest_server` puts GET /messages/search back on
# ILIKE '%term%', which no index can serve.
# See plans/2026-08-29_drill-11-full-text-search.md.
SEARCH_STRATEGY=
# off | on | header. Empty = the query-counter module's own default (on: count
# and warn past budget, no response header). header also sets x-query-count —
# the e2e suite always runs with it, see apps/backend/package.json.
QUERY_COUNTER=
# Postmaster-context, so this needs postgres_db recreated, not reloaded, and
# it is off by default for the same reason every other instrument here is:
# an always-on pg_stat_statements would silently change the baseline every
# later A/B is compared against. `PG_PRELOAD=pg_stat_statements docker
# compose up -d postgres_db`, then `pnpm db:stats:on`.
PG_PRELOAD=
